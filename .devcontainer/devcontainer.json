{
  "name": "PersonalGPT",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "PersonalGPT Web App",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt && cd frontend && npm install && npm run build && cd ..",
  "postStartCommand": "python run.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
