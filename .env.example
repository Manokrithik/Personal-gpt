# Application Environment
APP_ENV=development
APP_NAME=PersonalGPT
DEBUG=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
# SQLite default for local zero-config execution:
DATABASE_URL=sqlite+aiosqlite:///./data/personalgpt.db
# PostgreSQL for production / Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personalgpt

# Primary AI / LLM Provider (ollama, openai, gemini, anthropic, mock)
LLM_PROVIDER=ollama
DEFAULT_MODEL=llama3.2:1b

# Ollama Local Configuration (No API Key Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Cloud LLM Providers (Handled strictly on backend; never exposed to frontend)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Vector Store & Embeddings
VECTOR_STORE=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Uploads
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf", "txt", "md", "docx", "csv"]

# Feature Flags
ENABLE_RAG=true
ENABLE_MEMORY=true
ENABLE_TOOLS=true
ENABLE_AGENTS=true
ENABLE_VOICE=false

# Context & Memory Limits
MAX_CONTEXT_TOKENS=4096
SHORT_TERM_MESSAGE_LIMIT=10
MEMORY_EXTRACTION_THRESHOLD=3

# Logging
LOG_LEVEL=INFO
